#!/bin/sh
# 데이터·인사이트가 스테이지되면 해당 하네스를 돌려 실패 시 커밋을 막는다.
# 설치: cp hooks/pre-commit .git/hooks/ && chmod +x .git/hooks/pre-commit
#
# 유래(실제로 조용히 새어나간 사고들):
#  - 학과명에 '(외)' 잔존, 입결 등급 범위 이탈
#  - 수능최저 'N합M' 방향 오판 91전형(홍익대 3합8→2합5를 강화로 분류 → 유불리 판정이 반대)
#  - 인사이트가 권역별로 쪼개진 행 하나를 전형 총원으로 오기(경북대 지역의사 8명 ← 실제 26명)
# 이런 건 눈으로 안 보이고 배포 후에야 드러나므로 커밋 시점에 막는다.

cd "$(git rev-parse --show-toplevel)" || exit 1
STAGED=$(git diff --cached --name-only --diff-filter=ACM)
FAIL=0

# git hook은 최소 환경(LANG 미설정)으로 돈다. bash 3.2는 비-UTF8 로케일에서
# 한글 경로 glob('../입결*/*.xlsx')을 확장하지 못해 "파일 없음"으로 오판한다.
# 실제로 이 때문에 인사이트 하네스가 조용히 건너뛰어져 잘못된 커밋이 통과했다.
export LANG="${LANG:-en_US.UTF-8}"

run() {  # run <라벨> <스크립트> [인자...]
  LABEL="$1"; SCRIPT="$2"; shift 2
  [ -f "$SCRIPT" ] || { echo "  ! $SCRIPT 없음 — 건너뜀"; return; }
  echo "── $LABEL"
  if python3 "$SCRIPT" "$@"; then :; else FAIL=1; fi
}

echo "$STAGED" | grep -qE '^(data\.js|build_data\.py)$' && NEED_DATA=1
echo "$STAGED" | grep -qE '^match_util\.py$' && NEED_MATCH=1
echo "$STAGED" | grep -qE '^(insights\.js|build_ins\.py|merge_ins\.py|fix_ins_numbers\.py|apply_rewrite\.py)$' && NEED_INS=1
# 브라우저가 실제로 받아 가는 자산이 바뀌면 캐시버스터가 같이 갱신돼야 한다.
echo "$STAGED" | grep -qE '^(styles\.css|data\.js|insights\.js|apply_dates\.js|app\.js|index\.html)$' && NEED_STAMP=1

[ -z "$NEED_DATA$NEED_INS$NEED_MATCH$NEED_STAMP" ] && exit 0
echo "pre-commit: 데이터 하네스 실행"

# 캐시버스팅 게이트 — 데이터 하네스보다 먼저 돌린다(가장 싸고, 가장 조용히 새어나가는 사고다).
# 유래: app.js 만 스테이지하고 index.html 을 빠뜨려 배포했더니 서버는 새 파일을 주는데
#       브라우저는 옛 app.js 를 계속 썼다. 훅이 프런트 자산 변경을 아예 안 보고 있었던 탓이다.
#       실제로 그 직후 KAIST 접수 시각 교정도 같은 경로로 새어나갈 뻔했다(qa_known_issues ⑪ 이 손검사에서 잡음).
[ -n "$NEED_STAMP" ] && run "stamp_assets.py --check (캐시버스터)" stamp_assets.py --check

# 외부자료 조인용 정규화 — 로마숫자를 지우면 전형 Ⅰ/Ⅱ가 뒤섞여 허위 불일치가 대량 발생한다.
# 실제로 하루에 조인 버그를 세 번 냈고 그중 하나가 불일치를 64건으로 부풀렸다.
[ -n "$NEED_MATCH" ] && run "match_util.py (조인 정규화 자기검증)" match_util.py
[ -n "$NEED_DATA" ] && run "verify_data.py (data.js 불변식)" verify_data.py
# 경쟁률 산술 래칫 — 2026 경쟁률 × 2026 모집인원이 정수여야 한다는 제약으로
# 스냅샷(enroll26.json)·경쟁률·동명이단위 모순을 잡는다. 기존 37건은 기준선으로 고정돼
# 빌드를 막지 않고, 새 의심이 생길 때만 실패한다(전년대비 마크 오류의 선행 신호).
[ -n "$NEED_DATA" ] && run "qa_comp_ratio.py (경쟁률 산술 래칫)" qa_comp_ratio.py
# 추합 산술 래칫 — 충원합격자는 '지원자 − 모집인원'을 넘을 수 없다는 제약으로
# 추합·경쟁률·2026 모집인원 사이의 모순을 잡는다. 기존 40건은 기준선으로 고정된다.
[ -n "$NEED_DATA" ] && run "qa_chungwon.py (추합 산술 래칫)" qa_chungwon.py
# 외부 대조 회귀 감시 — 산술 검사가 원리적으로 못 잡는 오류를 막는다.
# 정수 경쟁률(구간이 너무 넓어 판정 불가)과 '다른 전형 값이 통째로 들어온' 오류가 그것이다.
# 대행사 최종 경쟁률 페이지와 한 번 대조해 확인한 12,090행을 지문으로 굳혀 두고, 그 값이 바뀌면 막는다.
[ -n "$NEED_DATA" ] && run "qa_c26_verified.py (외부 대조 회귀)" qa_c26_verified.py
# 입결 외부 대조 래칫 — 유원대 63행이 공식 발표와 통째로 무관했는데(context-notes 101) 그전까지
# 어디가 192교 대조를 '통과'했다. 입결은 대학마다 기준(50/70/90%컷·평균)이 달라 "다르면 우리 오류"로
# 단정할 수 없어 전수 판정이 계속 미뤄졌다 → 현재 불일치를 기준선에 박고 **새로 생기는 것만** 막는다.
[ -n "$NEED_DATA" ] && run "qa_ipgyeol_xcheck.py (입결 외부 대조 래칫)" qa_ipgyeol_xcheck.py
# 인사이트 하네스는 원천 엑셀 유무를 스스로 판단해 없으면 SKIP(exit 0)한다.
# 여기서 셸/glob으로 파일 존재를 확인하지 마라 — macOS는 파일명을 NFD로 저장해
# 한글 경로 glob(NFC 패턴)이 빈 결과를 내고, 그 탓에 하네스가 조용히 건너뛰어져
# 잘못된 인사이트가 커밋을 통과한 적이 있다.
[ -n "$NEED_INS" ] && run "verify_insights.py (인사이트 모집인원 ↔ 엑셀)" verify_insights.py

if [ "$FAIL" -ne 0 ]; then
  echo ""
  echo "커밋이 차단됐습니다. 위 위반을 고친 뒤 다시 커밋하세요."
  echo "(정말 넘겨야 하면: git commit --no-verify)"
  exit 1
fi
echo "pre-commit: 통과"
exit 0
